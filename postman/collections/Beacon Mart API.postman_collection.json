{
  "info": {
    "name": "Beacon Mart API",
    "description": "Automated checks for the Beacon Mart backend. Read-only except for login audit entries: no products, orders or users are created. Set adminEmail and adminPassword in the environment before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds in under 5 seconds', () => pm.expect(pm.response.responseTime).to.be.below(5000));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "branchId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "slotDate",
      "value": ""
    },
    {
      "key": "slotTime",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Public store",
      "item": [
        {
          "name": "Shop settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/shop/get_settings.php"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success, body.message).to.eql(true));",
                  "pm.test('SST is 6%', () => pm.expect(body.data.sst_rate).to.eql(0.06));",
                  "pm.test('delivery rules present', () => pm.expect(body.data).to.include.keys('free_delivery_threshold', 'delivery_base_fee', 'delivery_per_km', 'delivery_max_km', 'payment_window_minutes'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Branches",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/branches/get_branches.php"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success, body.message).to.eql(true));",
                  "pm.test('at least one branch with opening hours', () => { pm.expect(body.data.length).to.be.above(0); pm.expect(body.data[0]).to.have.property('opening_hours'); });",
                  "pm.test('branches have a map location for delivery', () => pm.expect(body.data[0]).to.include.keys('latitude', 'longitude'));",
                  "pm.collectionVariables.set('branchId', body.data[0].branch_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Products of a branch",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/get_products.php?branch_id={{branchId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success, body.message).to.eql(true));",
                  "pm.test('products have price and stock', () => { pm.expect(body.data.length).to.be.above(0); pm.expect(body.data[0]).to.include.keys('price', 'stock', 'sale_price', 'avg_rating'); });",
                  "const inStock = body.data.find(p => Number(p.stock) > 0);",
                  "pm.test('a product is in stock', () => pm.expect(inStock).to.be.an('object'));",
                  "if (inStock) pm.collectionVariables.set('productId', inStock.product_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delivery and pickup time slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/shop/get_slots.php?branch_id={{branchId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success, body.message).to.eql(true));",
                  "pm.test('slots are listed per day', () => { pm.expect(body.data).to.be.an('array'); if (body.data.length) pm.expect(body.data[0].slots).to.be.an('array').that.is.not.empty; });",
                  "if (body.data.length) { pm.collectionVariables.set('slotDate', body.data[0].date); pm.collectionVariables.set('slotTime', body.data[0].slots[0]); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Product reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reviews/get_reviews.php?product_id={{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success, body.message).to.eql(true));",
                  "pm.test('review summary', () => pm.expect(body.data.review_count).to.be.a('number'));"
                ]
              }
            }
          ]
        }
      ]
    },
